// A version resource -- the Details tab of a file's Properties in Explorer --
// so the Windows build has a .rsrc section, as the program in Ghidra's Memory
// Map help picture does.
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "reading_the_memory_map demo"
      VALUE "ProductName", "c-learning-library"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
